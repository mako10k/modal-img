MODAL_IMG_APP_ENV=development
MODAL_IMG_MODAL_APP_NAME=modal-img-execution
MODAL_IMG_MODAL_TEXT_TO_IMAGE_FUNCTION_NAME=submit_text_to_image
# Optional: set only when you need a non-default Modal environment.
# MODAL_IMG_MODAL_ENVIRONMENT_NAME=staging
# Legacy ComfyUI compatibility settings. Only checkpoint/output prefix still
# affect the current backend-built workflow payload shape; URL/timeout values
# remain for older direct-ComfyUI helpers during the migration.
MODAL_IMG_COMFYUI_BASE_URL=http://127.0.0.1:8188
MODAL_IMG_COMFYUI_TIMEOUT_SECONDS=30.0
MODAL_IMG_COMFYUI_HEALTH_TIMEOUT_SECONDS=2.0
MODAL_IMG_DEPENDENCY_HEALTH_TIMEOUT_SECONDS=2.0
MODAL_IMG_COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
MODAL_IMG_COMFYUI_OUTPUT_PREFIX=modal-img
MODAL_IMG_REDIS_URL=redis://127.0.0.1:6379/0
MODAL_IMG_POSTGRES_DSN=postgresql://modal_img:modal_img@127.0.0.1:5432/modal_img
MODAL_IMG_POSTGRES_CONNECT_TIMEOUT_SECONDS=5.0
MODAL_IMG_REDIS_TIMEOUT_SECONDS=5.0
MODAL_IMG_GENERATION_QUEUE_KEY=modal-img:generation-jobs
MODAL_IMG_FRONTEND_ORIGIN=http://127.0.0.1:43173